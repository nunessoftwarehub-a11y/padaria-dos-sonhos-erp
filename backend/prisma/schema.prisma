generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN CASHIER STAFF }
enum Unit { GRAM MILLILITER UNIT KILOGRAM LITER }

model Bakery {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  ingredients Ingredient[]
  recipes   Recipe[]
  products  Product[]
  sales     Sale[]
  createdAt2 DateTime @default(now()) @map("created_at_legacy")
}

model User {
  id           String   @id @default(uuid())
  bakeryId     String
  bakery       Bakery   @relation(fields: [bakeryId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  productions  Production[]
  sales        Sale[]
  cashSessions CashSession[]
}

model Ingredient {
  id String @id @default(uuid())
  bakeryId String
  bakery Bakery @relation(fields: [bakeryId], references: [id])
  name String
  category String
  supplier String?
  purchasePrice Decimal @db.Decimal(12,2)
  quantity Decimal @db.Decimal(12,3)
  unit Unit
  pricePerBaseUnit Decimal @db.Decimal(12,6)
  minimumStock Decimal @db.Decimal(12,3) @default(0)
  recipeItems RecipeIngredient[]
  movements StockMovement[]
}

model Recipe {
  id String @id @default(uuid())
  bakeryId String
  bakery Bakery @relation(fields: [bakeryId], references: [id])
  name String
  category String
  preparation String
  durationMinutes Int
  yieldQuantity Decimal @db.Decimal(12,3)
  lossPercent Decimal @db.Decimal(5,2) @default(0)
  costTotal Decimal @db.Decimal(12,2) @default(0)
  costPerUnit Decimal @db.Decimal(12,2) @default(0)
  recipeItems RecipeIngredient[]
  products Product[]
  productions Production[]
}

model RecipeIngredient {
  recipeId String
  ingredientId String
  quantity Decimal @db.Decimal(12,3)
  recipe Recipe @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
}

model Product {
  id String @id @default(uuid())
  bakeryId String
  bakery Bakery @relation(fields: [bakeryId], references: [id])
  recipeId String?
  recipe Recipe? @relation(fields: [recipeId], references: [id])
  name String
  barcode String?
  salePrice Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  saleItems SaleItem[]
}

model Production {
  id String @id @default(uuid())
  recipeId String
  userId String
  quantity Decimal @db.Decimal(12,3)
  producedAt DateTime @default(now())
  recipe Recipe @relation(fields: [recipeId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model StockMovement {
  id String @id @default(uuid())
  ingredientId String
  quantity Decimal @db.Decimal(12,3)
  reason String
  createdAt DateTime @default(now())
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model Sale {
  id String @id @default(uuid())
  bakeryId String
  userId String
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  bakery Bakery @relation(fields: [bakeryId], references: [id])
  user User @relation(fields: [userId], references: [id])
  items SaleItem[]
  payments Payment[]
}

model SaleItem {
  id String @id @default(uuid())
  saleId String
  productId String
  quantity Decimal @db.Decimal(12,3)
  unitPrice Decimal @db.Decimal(12,2)
  sale Sale @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id String @id @default(uuid())
  saleId String
  method String
  amount Decimal @db.Decimal(12,2)
  sale Sale @relation(fields: [saleId], references: [id])
}

model CashSession {
  id String @id @default(uuid())
  userId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  openingBalance Decimal @db.Decimal(12,2)
  closingBalance Decimal? @db.Decimal(12,2)
  user User @relation(fields: [userId], references: [id])
}